{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SqlServer": "Server=(localdb)\\MSSQLLocalDB;Database=OneClickYatra;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "OneClickYatra",
    "Audience": "OneClickYatraClients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Security": {
    "MaxFailedLoginAttempts": 5,
    "LockoutDurationMinutes": 15,
    "PasswordResetTokenMinutes": 30
  },
  "RateLimiting": {
    "PublicPermitLimit": 20,
    "PublicWindowSeconds": 60,
    "AuthPermitLimit": 5,
    "AuthWindowSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:4300",
      "http://127.0.0.1:4200",
      "http://127.0.0.1:4300"
    ]
  },
  "Hangfire": {
    "DashboardEnabled": true,
    "DashboardPath": "/hangfire"
  },
  "Payments": {
    "Razorpay": {
      "KeyId": "",
      "KeySecret": "",
      "WebhookSecret": ""
    }
  },
  "Notifications": {
    "WhatsApp": {
      "PhoneNumberId": "",
      "AccessToken": "",
      "WebhookVerifyToken": "",
      "AppSecret": ""
    },
    "Email": {
      "SmtpHost": "",
      "SmtpPort": 587,
      "SmtpUsername": "",
      "SmtpPassword": "",
      "FromAddress": "",
      "FromName": ""
    }
  },
  "FileStorage": {
    "LocalRootPath": ""
  }
}
