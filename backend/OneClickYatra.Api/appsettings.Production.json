{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "BehindReverseProxy": true,
  "RateLimiting": {
    "PublicPermitLimit": 60,
    "PublicWindowSeconds": 60,
    "AuthPermitLimit": 20,
    "AuthWindowSeconds": 60
  },
  "Hangfire": {
    "DashboardEnabled": false
  }
}
