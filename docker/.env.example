# Copy to .env and fill in real values. Never commit .env.
#
# Generate a strong JWT key (64+ chars):
#   openssl rand -base64 64

SQL_SA_PASSWORD=ChangeThis_Strong-Password1!
REDIS_PASSWORD=ChangeThis_Strong-Password2!
JWT_KEY=ChangeThis_Use_A_Random_64+_Character_Secret_Key_Never_Commit

# Your VM public IP or domain (no trailing slash).
# Examples: 123.45.67.89  or  oneclickyatra.example.com
PUBLIC_DOMAIN=YOUR_VM_PUBLIC_IP
